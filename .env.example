# Copy to .env and replace every value. These are local placeholders, not secrets to reuse.
ENVIRONMENT=development

# PostgreSQL (async driver for the app). Alembic rewrites +asyncpg to +psycopg.
DATABASE_URL=postgresql+asyncpg://antiterror:change-me-local-only@postgres:5432/antiterror
POSTGRES_PASSWORD=change-me-local-only

REDIS_URL=redis://redis:6379/0
RATE_LIMIT_BACKEND=redis

# Leave empty until you create the bot @antiterror_robot in BotFather.
BOT_TOKEN=
BOT_USERNAME=antiterror_robot

# Public HTTPS origin of the Mini App. Telegram opens WebApp buttons only for https.
WEBAPP_URL=https://localhost:8443
WEBHOOK_URL=
WEBHOOK_SECRET=

# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Local browser only. Must stay false in production.
ALLOW_DEV_AUTH=false
ADMIN_TELEGRAM_IDS=

CORS_ORIGINS=http://localhost:5173,https://localhost:8443

STORAGE_PATH=/data/evidence
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

DATA_RETENTION_DAYS=180
EMERGENCY_RETENTION_DAYS=30

# Optional. When set, uploads fail closed if ClamAV is unreachable.
CLAMAV_HOST=
CLAMAV_PORT=3310

RATE_LIMIT_REPORTS=5
RATE_LIMIT_REPORTS_WINDOW=3600
RATE_LIMIT_EVIDENCE=20
RATE_LIMIT_EVIDENCE_WINDOW=3600
RATE_LIMIT_READS=60
RATE_LIMIT_READS_WINDOW=60
INIT_DATA_MAX_AGE_SECONDS=86400
