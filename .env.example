# Local and production configuration.
# Copy to .env and replace every value. Never commit .env or real secrets.

APP_ENV=development
APP_NAME=AntiTerror Robot
LOG_LEVEL=INFO
FORCE_HTTPS=false
TRUST_PROXY=false
AUTO_CREATE_DB=false

# postgresql+asyncpg://USER:PASSWORD@HOST:5432/DB
DATABASE_URL=postgresql+asyncpg://antiterror:replace-with-local-password@postgres:5432/antiterror
POSTGRES_USER=antiterror
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_DB=antiterror

REDIS_URL=redis://redis:6379/0

# From @BotFather. Leave empty to run the API without the bot.
BOT_TOKEN=
BOT_USERNAME=antiterror_robot
BOT_DISPLAY_NAME=AntiTerror Robot
BOT_WEBHOOK_SECRET=
# polling for local development, webhook behind HTTPS, or disabled.
BOT_MODE=polling
# Public HTTPS URL of the Mini App. Required for the Telegram button.
WEBAPP_URL=

# Fernet key. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONTACT_ENCRYPTION_KEY=

# Comma-separated Telegram user ids. Empty means nobody has the role.
MODERATOR_TELEGRAM_IDS=
ADMIN_TELEGRAM_IDS=

# Local development only. Must stay false in production.
ALLOW_DEV_AUTH_BYPASS=false

S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=antiterror-evidence
# Local MinIO only. Replace both values before any shared or production deploy.
S3_ACCESS_KEY=local-minio-user
S3_SECRET_KEY=local-minio-secret-change
S3_REGION=us-east-1
LOCAL_STORAGE_PATH=/var/lib/antiterror/evidence

RETENTION_DAYS=180
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_REPORTS=10
RATE_LIMIT_REPORTS_WINDOW_SECONDS=3600

# Optional ClamAV daemon. Empty uses the built-in content checks only.
CLAMAV_HOST=
CLAMAV_PORT=3310

CORS_ORIGINS=
TELEGRAM_AUTH_MAX_AGE_SECONDS=86400

# Frontend dev server only. Do not enable against production.
VITE_DEV_USER_ID=
VITE_API_BASE=
