# Copy to .env and fill in real values locally. Never commit .env.
# Generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(48))"

ENVIRONMENT=development
ENFORCE_HTTPS=false
ALLOW_DEV_AUTH=false

# From @BotFather. Leave empty here.
BOT_TOKEN=
BOT_MODE=polling
WEBHOOK_SECRET=
PUBLIC_API_URL=https://localhost
WEBAPP_URL=https://localhost

DATABASE_URL=postgresql+asyncpg://antiterror:local-dev-only@db:5432/antiterror
POSTGRES_USER=antiterror
POSTGRES_PASSWORD=local-dev-only
POSTGRES_DB=antiterror

REDIS_URL=redis://redis:6379/0

CONTACT_ENCRYPTION_KEY=
LOG_HASH_SALT=

S3_ENDPOINT=http://minio:9000
S3_BUCKET=antiterror-evidence
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# Optional. When set, uploads are rejected if the scanner is unreachable.
CLAMAV_HOST=
CLAMAV_PORT=3310

PDF_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
RETENTION_DAYS=90

# Comma-separated Telegram user ids. Empty means no staff accounts.
MODERATOR_IDS=
ADMIN_IDS=

CORS_ORIGINS=http://localhost:5173,http://localhost:8080
VITE_DEV_USER_ID=
